{
  "name": "sanmu-particle-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-dsp.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-dsp.mjs && vite build",
    "build:dsp": "node scripts/build-dsp.mjs",
    "build:suite": "node scripts/build-suite.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:views": "node tests/signal-views.mjs",
    "test:studio": "node tests/studio.mjs",
    "test:glass": "node tests/glass.mjs",
    "test:settings": "node tests/studio-settings.mjs",
    "test:language": "node tests/studio-language.mjs",
    "test:visuals": "node tests/studio-visuals.mjs",
    "test:audio-recovery": "node tests/audio-recovery.mjs",
    "test:native-compat": "node tests/catalina-native-compat.mjs",
    "test:webgl-compat": "node tests/studio-webgl-compat.mjs"
  },
  "dependencies": {
    "lucide": "1.42.0",
    "three": "0.185.1",
    "three-webgl1": "npm:three@0.162.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "vite": "8.2.2"
  }
}
