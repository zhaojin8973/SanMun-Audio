---
// Direct seamless redirect to default locale (/zh/)
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>SanMu Audio</title>
    <meta http-equiv="refresh" content="0;url=/zh/" />
    <link rel="canonical" href="https://sanmuaudio.com/zh/" />
    <script is:inline>
      window.location.replace('/zh/');
    </script>
    <style>
      html, body {
        background: #ffffff;
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
    </style>
  </head>
  <body></body>
</html>
