---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Base lang="zh" title="404 — SanMu Audio" description="页面不存在。">
  <Nav lang="zh" />
  <main class="soon-hero wrap" style="padding-top:120px;">
    <h1 class="t-display">404</h1>
    <p class="prop">这个页面不存在或已被移动</p>
    <p class="desc t-body">回到首页，或从产品页开始逛。</p>
    <div class="hero-cta" style="justify-content:center;">
      <a class="btn btn--dark" href="/zh/">回到首页</a>
      <a class="btn btn--ghost" href="/zh/plugins/eq6">看看 EQ6</a>
    </div>
  </main>
  <Footer lang="zh" />
</Base>
