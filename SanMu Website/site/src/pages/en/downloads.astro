---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BetaDownloadCenter from '../../components/BetaDownloadCenter';
import { internalBeta } from '../../data/releases';
import '../../styles/support-pages.css';

const readingDocuments = internalBeta.documents.slice(0, 3);
const documentDescriptions = ['Explore the features, modes and uses of the four plug-ins.', 'Read about parameters, installation and everyday operation.', 'Review the AGPLv3 open-source license and installer terms.'];
---

<Base lang="en" title="Downloads — SanMu Audio" description="Get official signed installers and open-source code for SanMu Audio. Read product notes, user manuals and license terms.">
  <Nav lang="en" />
  <main class="sm-support-page">
    <header class="sm-support-hero">
      <p class="sm-support-eyebrow">SanMu Audio Open-Source Release</p>
      <h1>Product & Launch Preview</h1>
      <p class="sm-support-subtitle">Pricing and official launch details in preparation · Product docs & manuals available.</p>
      <p class="sm-support-hero-note">Signed & Notarized · Stay tuned for launch</p>
      <div class="sm-support-actions">
        <a class="button button-dark" href="#downloads">View Status</a>
        <a class="button button-outline" href="#documents">Read the docs</a>
      </div>
    </header>

    <section class="sm-support-downloads" id="downloads" aria-labelledby="sm-downloads-title">
      <div class="sm-support-section-heading">
        <h2 id="sm-downloads-title">Plug-in Suite.</h2>
        <p>macOS Universal 2 packages are signed and officially notarized by Apple. Pricing and release tiers are being finalized; downloads are temporarily paused.</p>
      </div>
      <div class="sm-support-version-list" aria-label="Current release versions">
        {internalBeta.products.map((product) => <span><strong>{product.name}</strong><small>v{product.version}</small></span>)}
      </div>
      <BetaDownloadCenter client:load lang="en" releaseId={internalBeta.id} />
      <p class="sm-support-release-link"><a class="text-link" href="/en/release">View platform details, versions and checksums ↗</a></p>
    </section>

    <section class="sm-support-band" id="documents" aria-labelledby="sm-documents-title">
      <div class="sm-support-band-inner">
        <div class="sm-support-section-heading">
          <h2 id="sm-documents-title">Get to know them first.</h2>
          <p>No account is needed to read these documents. They cover the {internalBeta.date} release.</p>
        </div>
        <div class="sm-support-doc-grid">
          {readingDocuments.map((document, index) => <a class="sm-support-doc" href={`/docs/${internalBeta.id}/${document.enPath}`} target="_blank" rel="noopener">
            <span class="sm-support-doc-index">0{index + 1}</span>
            <h3>{document.en}</h3>
            <p>{documentDescriptions[index]}</p>
            <span class="sm-support-doc-link">Read document <span aria-hidden="true">↗</span></span>
          </a>)}
        </div>
        <p class="sm-support-doc-footer">All beta time limits have been removed for permanent use. Report issues through the <a class="text-link" href="/en/about">feedback and contact page</a>.</p>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>
