---
import { productList } from '../data/products';
interface Props { lang: 'zh' | 'en'; current?: 'products' | 'about' | 'faq'; }
const { lang, current } = Astro.props;
const t = lang === 'zh'
  ? { products:'插件', about:'工作室', faq:'支持', downloads:'下载', menu:'打开导航', language:'切换到英文' }
  : { products:'Plug-ins', about:'Studio', faq:'Support', downloads:'Downloads', menu:'Open navigation', language:'Switch to Chinese' };
const base = `/${lang}`;
const path = Astro.url.pathname.replace(/^\/(zh|en)/, '') || '/';
const switchHref = /^\/(zh|en)/.test(Astro.url.pathname) ? `/${lang === 'zh' ? 'en' : 'zh'}${path}` : `/${lang === 'zh' ? 'en' : 'zh'}/`;
---
<nav class="nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
  <a href={`${base}/`} class="nav-brand" aria-label="SanMu Audio">
    <span class="site-brand" aria-hidden="true"><strong class="site-brand-wordmark">SanMu</strong><span class="site-brand-audio"><span>A</span><span>u</span><span>d</span><span>i</span><span>o</span></span></span>
  </a>
  <div class="nav-links">
    <div class="nav-item-dropdown">
      <button type="button" class="nav-product-trigger" aria-expanded="false" aria-controls="product-menu" aria-current={current === 'products' ? 'true' : undefined}>
        {t.products}<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
      <div class="nav-dropdown-menu" id="product-menu" hidden>
        {productList.map(product => <a href={`${base}/plugins/${product.slug}`} class="nav-dropdown-item"><span class="nav-product-dot" style={`--dot-color:${product.accent}`}></span><div><b>{product.name}</b><small>{product[lang].kicker}</small></div><span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
    <a class="link" href={`${base}/about`} aria-current={current === 'about' ? 'page' : undefined}>{t.about}</a>
    <a class="link" href={`${base}/faq`} aria-current={current === 'faq' ? 'page' : undefined}>{t.faq}</a>
  </div>
  <div class="nav-actions"><a class="nav-language" href={switchHref} aria-label={t.language}>{lang === 'zh' ? 'EN' : '中文'}</a><a class="nav-download" href={`${base}/downloads`}>{t.downloads}<span aria-hidden="true">↓</span></a><button type="button" class="burger" aria-label={t.menu} aria-expanded="false" aria-controls="nav-menu"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></button></div>
  <div class="navmenu" id="nav-menu" hidden>
    {productList.map(product => <a class="navmenu__link" href={`${base}/plugins/${product.slug}`}>{product.name}<span aria-hidden="true">↗</span></a>)}
    <a class="navmenu__link" href={`${base}/about`}>{t.about}</a><a class="navmenu__link" href={`${base}/faq`}>{t.faq}</a><a class="navmenu__link" href={`${base}/downloads`}>{t.downloads}</a>
  </div>
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const trigger = nav?.querySelector<HTMLButtonElement>('.nav-product-trigger');
  const dropdown = nav?.querySelector<HTMLElement>('.nav-dropdown-menu');
  const burger = nav?.querySelector<HTMLButtonElement>('.burger');
  const menu = nav?.querySelector<HTMLElement>('.navmenu');
  const close = () => { if (dropdown) dropdown.hidden = true; if (menu) menu.hidden = true; trigger?.setAttribute('aria-expanded', 'false'); burger?.setAttribute('aria-expanded', 'false'); };
  trigger?.addEventListener('click', () => { const open = dropdown?.hidden; close(); if (dropdown) dropdown.hidden = !open; trigger.setAttribute('aria-expanded', String(open)); });
  burger?.addEventListener('click', () => { const open = menu?.hidden; close(); if (menu) menu.hidden = !open; burger.setAttribute('aria-expanded', String(open)); });
  document.addEventListener('click', event => { if (!nav?.contains(event.target as Node)) close(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && (trigger?.getAttribute('aria-expanded') === 'true' || burger?.getAttribute('aria-expanded') === 'true')) { const focus = menu?.hidden ? trigger : burger; close(); focus?.focus(); } });
  nav?.addEventListener('focusout', event => { if (!nav.contains(event.relatedTarget as Node)) close(); });
</script>
