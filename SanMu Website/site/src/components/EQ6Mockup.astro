---
interface Props {
  variant?: 'small' | 'full';
  theme?: 'light' | 'dark';
}
const { variant = 'small', theme = 'light' } = Astro.props;

import { mockupPalettes as palettes } from './mockup-theme';
const p = palettes[theme];
const gid = (n: string) => n + '-' + variant + '-' + theme;
const U = (n: string) => 'url(#' + n + '-' + variant + '-' + theme + ')';

// 按实机截图 1:1 重绘的口径（2026-09 用户提供 REAPER 实拍，Light/Dark 两主题参考）
// 布局：顶部工具条 + 频谱分析仪 + 频响曲线 + 六段 GAIN/FREQ/Q 旋钮组 + INPUT/OUTPUT 纵表 + 右上 OUT 表
// 曲线锚点与旋转钩子沿用旧几何（动画 CSS 不失效）
const bands = [
  { color: '#1d4ed8', gain: '0.0 dB', freq: '80.0 Hz', q: '0.71' },
  { color: '#059669', gain: '-2.0 dB', freq: '200 Hz', q: '1.00' },
  { color: '#d97706', gain: '+4.0 dB', freq: '2.3 kHz', q: '1.00' },
  { color: '#e11d48', gain: '+2.0 dB', freq: '5.0 kHz', q: '1.00' },
  { color: '#7c3aed', gain: '+3.0 dB', freq: '8.0 kHz', q: '0.71' },
  { color: '#c026d3', gain: '0.0 dB', freq: '16 kHz', q: '0.71' },
];
---

{variant === 'small' ? (
  <svg viewBox="0 0 600 332" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SanMu EQ6">
    <defs>
      <linearGradient id={'uibg-' + variant + '-' + theme} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={p.bg1} /><stop offset="1" stop-color={p.bg2} /></linearGradient>
      <linearGradient id={'meter-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#34D399" /><stop offset="1" stop-color="#0f766e" /></linearGradient>
      <linearGradient id={'fft1-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#1d4ed8" stop-opacity="0.30" /><stop offset="0.5" stop-color="#7c3aed" stop-opacity="0.20" /><stop offset="1" stop-color="#c026d3" stop-opacity="0.28" /></linearGradient>
      <linearGradient id={'aeqSheen-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff" stop-opacity="0" /><stop offset="0.5" stop-color="#ffffff" stop-opacity="0.55" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" /></linearGradient>
    </defs>
    <rect x="1" y="1" width="598" height="330" rx="14" fill={U('uibg')} stroke={p.edge} />
    <rect class="aeq-sheen" x="-260" y="1" width="180" height="330" fill={U('aeqSheen')} opacity="0" />

    <text x="26" y="30" font-family="Figtree,-apple-system,'PingFang SC',sans-serif" font-size="18" font-weight="800" fill={p.ink}>SanMu</text>
    <text x="92" y="30" font-family="Figtree,-apple-system,sans-serif" font-size="11" font-weight="600" fill={p.ink2}>EQ6</text>
    <text x="118" y="30" font-family="Figtree,-apple-system,sans-serif" font-size="8" letter-spacing="3" fill={p.ink3}>AUDIO</text>
    <text x="26" y="44" font-family="Figtree,-apple-system,'PingFang SC',sans-serif" font-size="8" fill={p.ink2}>六段参量均衡器</text>
    <g font-family="Figtree,-apple-system,sans-serif" font-size="7.5" fill={p.ink2}>
      <rect x="412" y="18" width="60" height="16" rx="8" fill={p.pill} stroke={p.pillEdge} /><text x="442" y="29" text-anchor="middle">Zero Latency</text>
      <circle cx="486" cy="26" r="8" fill={p.toolBg} stroke={p.pillEdge} /><text x="483" y="28.5" font-size="7" text-anchor="middle">↺</text>
      <rect x="502" y="18" width="34" height="16" rx="8" fill={p.toolBg} stroke={p.pillEdge} /><text x="519" y="29" text-anchor="middle">A/B</text>
    </g>
    <rect x="538" y="46" width="36" height="5" rx="2.5" fill={p.track} />
    <rect x="538" y="46" width="24" height="5" rx="2.5" fill={U('meter')} class="aeq-meter aeq-meter-l"/>
    <rect x="570" y="46" width="4" height="5" rx="1.5" fill="#ff7875" opacity="0.4" />
    <rect x="538" y="55" width="36" height="5" rx="2.5" fill={p.track} />
    <rect x="538" y="55" width="20" height="5" rx="2.5" fill={U('meter')} class="aeq-meter aeq-meter-r"/>
    <rect x="570" y="55" width="4" height="5" rx="1.5" fill="#ff7875" opacity="0.4" />

    {/* 频谱分析仪 */}
    <path d="M 26 236 L 30 226 L 40 240 L 52 220 L 64 200 L 78 216 L 92 190 L 108 168 L 124 182 L 140 160 L 158 178 L 176 150 L 194 170 L 212 188 L 230 172 L 248 196 L 266 214 L 284 196 L 302 210 L 320 228 L 338 216 L 356 200 L 374 214 L 392 224 L 410 208 L 428 192 L 446 206 L 464 218 L 482 208 L 500 196 L 518 208 L 536 220 L 554 210 L 570 200 L 574 196 L 574 244 L 26 244 Z" fill={U('fft1')} opacity={p.fft} />

    <g stroke={p.grid} stroke-width="1">
      <line x1="26" y1="74" x2="574" y2="74" /><line x1="26" y1="122" x2="574" y2="122" />
      <line x1="26" y1="170" x2="574" y2="170" /><line x1="26" y1="218" x2="574" y2="218" />
      <line x1="26" y1="266" x2="574" y2="266" />
      <line x1="138" y1="74" x2="138" y2="266" /><line x1="206" y1="74" x2="206" y2="266" />
      <line x1="274" y1="74" x2="274" y2="266" /><line x1="342" y1="74" x2="342" y2="266" />
      <line x1="410" y1="74" x2="410" y2="266" /><line x1="478" y1="74" x2="478" y2="266" />
      <line x1="546" y1="74" x2="546" y2="266" />
    </g>
    <g font-family="Figtree,-apple-system,sans-serif" font-size="8.5" fill={p.ink3}>
      <text x="30" y="78">+12</text><text x="33" y="126">+6</text><text x="36" y="174">0</text>
      <text x="33" y="222">−6</text><text x="30" y="270">−12</text>
      <text x="108" y="280">50</text><text x="178" y="280">100</text><text x="248" y="280">200</text>
      <text x="316" y="280">500</text><text x="382" y="280">1k</text><text x="450" y="280">2k</text>
      <text x="518" y="280">5k</text><text x="558" y="280">10k</text>
    </g>

    <path d="M 26 130 Q 116 130 150 160 Q 190 192 230 172 Q 280 148 328 176 Q 380 206 420 188 Q 466 168 496 178 Q 522 186 574 166" fill="none" stroke={p.curve} stroke-width="2" stroke-linecap="round" class="aeq-curve" />
    <path d="M 26 130 Q 116 130 150 160 Q 190 192 230 172 Q 280 148 328 176 Q 380 206 420 188 Q 466 168 496 178 Q 522 186 574 166" fill="none" stroke="rgba(52,211,153,0.25)" stroke-width="7" stroke-linecap="round" class="aeq-curve-glow" />
    <circle cx="116" cy="130" r="4" fill="#1d4ed8" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-0" />
    <circle cx="230" cy="172" r="4" fill="#059669" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-1" />
    <circle cx="328" cy="176" r="4" fill="#d97706" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-2" />
    <circle cx="420" cy="188" r="4" fill="#e11d48" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-3" />
    <circle cx="496" cy="178" r="4" fill="#7c3aed" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-4" />
    <circle cx="574" cy="166" r="4" fill="#c026d3" stroke="#fff" stroke-width="1.4" class="aeq-dot aeq-dot-5" />

    {/* GAIN 胶囊 + FREQ/Q 标签（实机缩影） */}
    <g font-family="Figtree,-apple-system,sans-serif">
      {bands.map((b, i) => {
        const x = 82 + i * 86;
        return (
          <g>
            <circle cx={x - 34} cy="297" r="2.5" fill={b.color} />
            <rect x={x - 56} y="289" width="42" height="13" rx="6.5" fill={p.pill} stroke={p.pillEdge} />
            <text x={x - 35} y="298.5" font-size="7" font-weight="600" fill={b.color} text-anchor="middle">{b.gain}</text>
            <text x={x - 35} y="312" font-size="6.5" fill={p.ink2} text-anchor="middle">FREQ {b.freq}</text>
            <text x={x - 35} y="323" font-size="6.5" fill={p.ink2} text-anchor="middle">Q {b.q}</text>
          </g>
        );
      })}
      <text x="12" y="296" font-size="6.5" fill={p.ink2}>IN</text>
      <rect x="10" y="300" width="4" height="26" rx="2" fill={p.track} />
      <rect x="10" y="300" width="4" height="18" rx="2" fill={U('meter')} />
      <text x="584" y="296" font-size="6.5" fill={p.ink2}>OUT</text>
      <rect x="582" y="300" width="4" height="26" rx="2" fill={p.track} />
      <rect x="582" y="300" width="4" height="21" rx="2" fill={U('meter')} />
    </g>
  </svg>
) : (
  <svg viewBox="0 0 940 520" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="SanMu EQ6">
    <defs>
      <linearGradient id={'bg2-' + variant + '-' + theme} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={p.bg1} /><stop offset="1" stop-color={p.bg2} /></linearGradient>
      <linearGradient id={'meter2-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#34D399" /><stop offset="1" stop-color="#0f766e" /></linearGradient>
      <linearGradient id={'fft2-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#1d4ed8" stop-opacity="0.25" /><stop offset="0.5" stop-color="#7c3aed" stop-opacity="0.18" /><stop offset="1" stop-color="#c026d3" stop-opacity="0.25" /></linearGradient>
      <linearGradient id={'aeqSheen-' + variant + '-' + theme} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff" stop-opacity="0" /><stop offset="0.5" stop-color="#ffffff" stop-opacity="0.55" /><stop offset="1" stop-color="#ffffff" stop-opacity="0" /></linearGradient>
    </defs>
    <rect x="1" y="1" width="938" height="518" rx="18" fill={U('bg2')} stroke={p.edge} />
    <rect class="aeq-sheen" x="-260" y="1" width="200" height="518" fill={U('aeqSheen')} opacity="0" />

    <text x="26" y="42" font-family="Figtree,-apple-system,'PingFang SC',sans-serif" font-size="24" font-weight="800" fill={p.ink}>SanMu</text>
    <rect x="112" y="20" width="38" height="24" rx="6" fill={p.logoBox} stroke={p.logoEdge} />
    <text x="131" y="37" font-family="Figtree,-apple-system,sans-serif" font-size="12" font-weight="700" fill={p.logoText} text-anchor="middle">EQ6</text>
    <text x="162" y="36" font-family="Figtree,-apple-system,sans-serif" font-size="9" letter-spacing="4" fill={p.ink3}>AUDIO</text>
    <g font-family="Figtree,-apple-system,sans-serif" font-size="9" fill={p.ink2} text-anchor="middle">
      <rect x="300" y="22" width="26" height="22" rx="11" fill={p.toolBg} stroke={p.pillEdge} /><text x="313" y="36.5">↺</text>
      <rect x="332" y="22" width="26" height="22" rx="11" fill={p.toolBg} stroke={p.pillEdge} /><text x="345" y="36.5">↻</text>
      <rect x="364" y="22" width="46" height="22" rx="11" fill={p.toolBg} stroke={p.pillEdge} /><text x="387" y="36.5">A / B</text>
      <rect x="416" y="22" width="52" height="22" rx="11" fill={p.toolBg} /><text x="442" y="36.5">AUTO</text>
      <rect x="474" y="22" width="120" height="22" rx="11" fill={p.pill} stroke={p.pillEdge} /><text x="534" y="36.5">Zero Latency</text>
      <rect x="600" y="22" width="140" height="22" rx="11" fill={p.pill} stroke={p.pillEdge} /><text x="670" y="36.5">Default Settings</text>
      <circle cx="766" cy="33" r="11" fill={p.toolBg} stroke={p.pillEdge} /><text x="766" y="36">⚙</text>
      <text x="797" y="36.5" font-weight="600" fill="#e11d48">BYP</text>
      <rect x="820" y="20" width="96" height="9" rx="4.5" fill={p.track} />
      <rect x="820" y="20" width="78" height="9" rx="4.5" fill={U('meter2')} class="aeq-meter aeq-meter-l"/>
      <rect x="908" y="20" width="8" height="9" rx="2" fill="#ff7875" opacity="0.4" />
      <rect x="820" y="35" width="96" height="9" rx="4.5" fill={p.track} />
      <rect x="820" y="35" width="64" height="9" rx="4.5" fill={U('meter2')} class="aeq-meter aeq-meter-r"/>
      <rect x="908" y="35" width="8" height="9" rx="2" fill="#ff7875" opacity="0.4" />
    </g>

    {/* 频谱分析仪（实机 FFT 填充） */}
    <path d="M 30 250 L 50 226 L 70 244 L 90 210 L 112 196 L 134 214 L 156 186 L 180 162 L 204 180 L 228 154 L 252 176 L 276 200 L 300 184 L 324 206 L 348 230 L 372 214 L 396 236 L 420 246 L 444 226 L 468 206 L 492 222 L 516 238 L 540 222 L 564 208 L 588 220 L 612 234 L 636 224 L 660 210 L 684 220 L 708 232 L 732 222 L 756 210 L 780 222 L 804 234 L 828 224 L 852 214 L 876 222 L 884 228 L 884 332 L 30 332 Z" fill={U('fft2')} opacity={p.fft} />
    <text x="466" y="222" font-family="Figtree,-apple-system,sans-serif" font-size="10" fill={p.ink2} text-anchor="middle">913 Hz · −27.0 dBFS</text>

    <g stroke={p.grid} stroke-width="1">
      <line x1="30" y1="92" x2="910" y2="92" /><line x1="30" y1="152" x2="910" y2="152" />
      <line x1="30" y1="212" x2="910" y2="212" /><line x1="30" y1="272" x2="910" y2="272" />
      <line x1="30" y1="332" x2="910" y2="332" />
      <line x1="172" y1="92" x2="172" y2="332" /><line x1="260" y1="92" x2="260" y2="332" />
      <line x1="348" y1="92" x2="348" y2="332" /><line x1="436" y1="92" x2="436" y2="332" />
      <line x1="524" y1="92" x2="524" y2="332" /><line x1="612" y1="92" x2="612" y2="332" />
      <line x1="700" y1="92" x2="700" y2="332" /><line x1="788" y1="92" x2="788" y2="332" />
      <line x1="876" y1="92" x2="876" y2="332" />
    </g>
    <g font-family="Figtree,-apple-system,sans-serif" font-size="9.5" fill={p.ink3}>
      <text x="34" y="96">+12</text><text x="37" y="156">+6</text><text x="40" y="216">0</text>
      <text x="37" y="276">−6</text><text x="34" y="336">−12</text>
      <text x="140" y="348">50</text><text x="230" y="348">100</text><text x="318" y="348">200</text>
      <text x="406" y="348">500</text><text x="492" y="348">1k</text><text x="580" y="348">2k</text>
      <text x="668" y="348">5k</text><text x="858" y="348">10k</text>
    </g>

    <path d="M 30 148 Q 138 148 176 186 Q 222 230 272 208 Q 332 182 386 216 Q 446 254 492 232 Q 546 206 582 218 Q 612 228 910 198" fill="none" stroke={p.curve} stroke-width="2.2" stroke-linecap="round" class="aeq-curve" />
    <path d="M 30 148 Q 138 148 176 186 Q 222 230 272 208 Q 332 182 386 216 Q 446 254 492 232 Q 546 206 582 218 Q 612 228 910 198" fill="none" stroke="rgba(52,211,153,0.22)" stroke-width="8" stroke-linecap="round" class="aeq-curve-glow" />
    <circle cx="138" cy="148" r="4.5" fill="#1d4ed8" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-0" />
    <circle cx="272" cy="208" r="4.5" fill="#059669" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-1" />
    <circle cx="386" cy="216" r="4.5" fill="#d97706" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-2" />
    <circle cx="492" cy="232" r="4.5" fill="#e11d48" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-3" />
    <circle cx="582" cy="218" r="4.5" fill="#7c3aed" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-4" />
    <circle cx="910" cy="198" r="4.5" fill="#c026d3" stroke="#fff" stroke-width="1.5" class="aeq-dot aeq-dot-5" />

    {/* 六段 GAIN 胶囊 + FREQ/Q 旋钮组（按实机截图） */}
    <g font-family="Figtree,-apple-system,sans-serif">
      {bands.map((b, i) => {
        const x = 118 + i * 128;
        const arc = [
          'M 78 422 A 34 34 0 0 1 129.8 463', 'M 224 422 A 34 34 0 0 1 248.9 426',
          'M 370 422 A 34 34 0 0 1 424 466', 'M 516 422 A 34 34 0 0 1 560 420',
          'M 662 422 A 34 34 0 0 1 715.8 456', 'M 808 422 A 34 34 0 0 1 856 470',
        ][i];
        return (
          <g>
            <circle cx={x - 58} cy="368" r="3.5" fill={b.color} />
            <text x={x - 51} y="371" font-size="8.5" fill={p.ink2}>GAIN</text>
            <rect x={x - 62} y="376" width="54" height="18" rx="9" fill={p.pill} stroke={p.pillEdge} />
            <text x={x - 35} y="389" font-size="9.5" font-weight="700" fill={b.color} text-anchor="middle">{b.gain}</text>
            <text x={x - 35} y="412" font-size="8.5" fill={p.ink2} text-anchor="middle">FREQ</text>
            <circle cx={x - 35} cy="446" r="34" fill="none" stroke={p.pillEdge} stroke-width="3.5" />
            <path d={arc} fill="none" stroke={b.color} stroke-width="6" stroke-linecap="round" class={`aeq-knob aeq-knob-${i}`} />
            <text x={x - 35} y="438" font-size="9.5" font-weight="600" fill={b.color} text-anchor="middle">{b.freq}</text>
            <text x={x - 35} y="460" font-size="8.5" fill={p.ink2} text-anchor="middle">FREQ</text>
            <text x={x - 35} y="476" font-size="8.5" fill={p.ink2} text-anchor="middle">Q {b.q}</text>
          </g>
        );
      })}
      <text x="14" y="378" font-size="8" fill={p.ink2}>INPUT</text>
      <rect x="12" y="384" width="6" height="110" rx="3" fill={p.track} />
      <rect x="12" y="384" width="6" height="72" rx="3" fill={U('meter2')} />
      <text x="918" y="378" font-size="8" fill={p.ink2} text-anchor="end">OUTPUT</text>
      <rect x="920" y="384" width="6" height="110" rx="3" fill={p.track} />
      <rect x="920" y="384" width="6" height="86" rx="3" fill={U('meter2')} />
    </g>
  </svg>
)}
